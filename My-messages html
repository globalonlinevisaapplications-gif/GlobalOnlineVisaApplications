
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#12345a">
<title>My Messages | Global Online Visa Applications</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="config.js"></script>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 font-family:Arial,sans-serif;
 background:#f3f6fa;
 color:#253047;
}
header{
 background:#12345a;
 color:white;
 padding:20px 6%;
 display:flex;
 justify-content:space-between;
 align-items:center;
 flex-wrap:wrap;
 gap:12px;
}
header h2{margin:0;font-size:20px}
nav{display:flex;gap:15px;flex-wrap:wrap}
nav a{color:white;text-decoration:none;font-size:14px}
main{max-width:850px;margin:30px auto;padding:0 15px}
.card{
 background:white;
 padding:22px;
 margin-bottom:20px;
 border-radius:12px;
 box-shadow:0 3px 12px #0000000c;
}
h3{margin-top:0;color:#12345a}
.status{
 padding:12px;
 background:#edf4fa;
 border-radius:7px;
 margin-bottom:15px;
 font-size:14px;
}
.error{background:#ffeaea;color:#a40000}
.message{
 padding:14px;
 margin:12px 0;
 border-radius:10px;
 max-width:90%;
 overflow-wrap:anywhere;
}
.admin{
 background:#edf3fa;
 border-left:4px solid #1265a0;
 margin-right:auto;
}
.applicant{
 background:#e5f5e9;
 border-left:4px solid #219653;
 margin-left:auto;
}
.sender{font-weight:bold;margin-bottom:7px;font-size:13px}
.message-text{white-space:pre-wrap;line-height:1.5}
.date{font-size:11px;color:#667;margin-top:8px}
textarea{
 width:100%;
 min-height:120px;
 padding:13px;
 border:1px solid #ccd5df;
 border-radius:8px;
 font:15px Arial;
}
button{
 border:0;
 padding:12px 18px;
 border-radius:7px;
 background:#1265a0;
 color:white;
 font-weight:bold;
 cursor:pointer;
}
button:disabled{opacity:.6}
.secondary{background:#526579}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
#conversation{max-height:500px;overflow-y:auto}
footer{text-align:center;padding:20px;color:#777;font-size:12px}
</style>
</head>

<body>

<header>
<h2>Global Online Visa Applications</h2>
<nav>
<a href="/">Home</a>
<a href="/apply.html">Apply & Track</a>
</nav>
</header>

<main>

<div class="card">
<h3>My Messages</h3>
<p>Welcome to your secure applicant messaging centre. You can receive updates and communicate directly with the Administrator.</p>

<div id="status" class="status">Connecting to your account...</div>

<div class="actions">
<button type="button" class="secondary" onclick="loadMessages()">Refresh Messages</button>
<button type="button" class="secondary" onclick="signOut()">Sign Out</button>
</div>
</div>

<div class="card">
<h3>Messages from Administrator</h3>
<div id="adminMessages">
<p>Loading messages...</p>
</div>
</div>

<div class="card">
<h3>Your Conversation with Administrator</h3>
<div id="conversation">
<p>Loading conversation...</p>
</div>
</div>

<div class="card">
<h3>Reply to Administrator</h3>
<p>Write your message below. The Administrator will be able to read and respond to you.</p>

<form id="replyForm">
<textarea id="replyText" maxlength="5000" placeholder="Write your message here..." required></textarea>

<div class="actions">
<button type="submit" id="sendBtn">Send Message</button>
</div>
</form>
</div>

</main>

<footer>
© <span id="year"></span> Global Online Visa Applications
</footer>

<script>
let db;
let currentUser=null;

const statusBox=document.getElementById("status");
const adminBox=document.getElementById("adminMessages");
const conversationBox=document.getElementById("conversation");

document.getElementById("year").textContent=new Date().getFullYear();

function setStatus(message,error=false){
 statusBox.textContent=message;
 statusBox.className=error?"status error":"status";
}

function escapeHTML(value){
 return String(value??"").replace(/[&<>"']/g,function(c){
  return {
   "&":"&amp;",
   "<":"&lt;",
   ">":"&gt;",
   '"':"&quot;",
   "'":"&#39;"
  }[c];
 });
}

function formatDate(value){
 const date=new Date(value);
 return isNaN(date.getTime())?"":date.toLocaleString();
}

function getClient(){
 if(!window.supabase ||
    !window.SUPABASE_URL ||
    !window.SUPABASE_ANON_KEY){
  throw new Error("Supabase configuration missing. Check config.js.");
 }

 if(!window.supabaseClient){
  window.supabaseClient=window.supabase.createClient(
   window.SUPABASE_URL,
   window.SUPABASE_ANON_KEY
  );
 }
 return window.supabaseClient;
}

async function initialise(){
 try{
  db=getClient();

  const {data,error}=await db.auth.getSession();
  if(error)throw error;

  currentUser=data.session?.user;

  if(!currentUser){
   setStatus("Please sign in using your applicant account on the Apply & Track page.",true);
   adminBox.innerHTML="";
   conversationBox.innerHTML="";
   document.getElementById("replyText").disabled=true;
   document.getElementById("sendBtn").disabled=true;
   return;
  }

  await loadMessages();

 }catch(error){
  console.error(error);
  setStatus(error.message||"Unable to connect to your account.",true);
 }
}

async function loadMessages(){
 if(!currentUser||!db)return;

 try{
  setStatus("Loading your messages...");

  const [notifications,replies]=await Promise.all([

   db.from("applicant_messages")
    .select("id,message,is_read,created_at,sender_name")
    .eq("recipient_user_id",currentUser.id)
    .order("created_at",{ascending:false})
    .limit(100),

   db.from("applicant_message_replies")
    .select("id,message,sender_role,is_read,created_at")
    .eq("applicant_user_id",currentUser.id)
    .order("created_at",{ascending:true})
    .limit(200)

  ]);

  if(notifications.error)throw notifications.error;
  if(replies.error)throw replies.error;

  const messages=notifications.data||[];
  const conversation=replies.data||[];

  displayAdminMessages(messages);
  displayConversation(conversation);

  const unreadMessages=messages
   .filter(m=>!m.is_read)
   .map(m=>m.id);

  if(unreadMessages.length){
   const {error}=await db.from("applicant_messages")
    .update({is_read:true})
    .in("id",unreadMessages)
    .eq("recipient_user_id",currentUser.id);

   if(error)console.warn(error.message);
  }

  const unreadReplies=conversation
   .filter(m=>m.sender_role==="admin"&&!m.is_read)
   .map(m=>m.id);

  if(unreadReplies.length){
   const {error}=await db.from("applicant_message_replies")
    .update({is_read:true})
    .in("id",unreadReplies)
    .eq("applicant_user_id",currentUser.id);

   if(error)console.warn(error.message);
  }

  setStatus("Your messages have been loaded successfully.");

 }catch(error){
  console.error(error);
  setStatus("Unable to load messages: "+error.message,true);
 }
}

function displayAdminMessages(messages){
 if(!messages.length){
  adminBox.innerHTML="<p>You have no new Administrator notifications.</p>";
  return;
 }

 adminBox.innerHTML=messages.map(m=>`
  <div class="message admin">
   <div class="sender">Administrator</div>
   <div class="message-text">${escapeHTML(m.message)}</div>
   <div class="date">
    ${escapeHTML(formatDate(m.created_at))}
    · ${m.is_read?"Read":"Unread"}
   </div>
  </div>
 `).join("");
}

function displayConversation(messages){
 if(!messages.length){
  conversationBox.innerHTML="<p>No conversation yet. You can send the Administrator a message below.</p>";
  return;
 }

 conversationBox.innerHTML=messages.map(m=>{
  const applicant=m.sender_role==="applicant";

  return `
   <div class="message ${applicant?"applicant":"admin"}">
    <div class="sender">
     ${applicant?"You":"Administrator"}
    </div>

    <div class="message-text">${escapeHTML(m.message)}</div>

    <div class="date">
     ${escapeHTML(formatDate(m.created_at))}
     · ${m.is_read?"Read":"Sent"}
    </div>
   </div>
  `;
 }).join("");

 conversationBox.scrollTop=conversationBox.scrollHeight;
}

document.getElementById("replyForm").addEventListener("submit",async function(event){
 event.preventDefault();

 if(!currentUser||!db){
  setStatus("Please sign in first.",true);
  return;
 }

 const message=document.getElementById("replyText").value.trim();

 if(!message)return;

 const button=document.getElementById("sendBtn");
 button.disabled=true;
 button.textContent="Sending...";

 try{
  const {error}=await db.from("applicant_message_replies").insert({
   applicant_user_id:currentUser.id,
   sender_user_id:currentUser.id,
   sender_role:"applicant",
   message:message
  });

  if(error)throw error;

  document.getElementById("replyText").value="";
  setStatus("Your message was sent successfully to the Administrator.");

  await loadMessages();

 }catch(error){
  console.error(error);
  setStatus("Message could not be sent: "+error.message,true);
 }finally{
  button.disabled=false;
  button.textContent="Send Message";
 }
});

async function signOut(){
 if(!db)return;

 const {error}=await db.auth.signOut();

 if(error){
  setStatus("Sign out failed: "+error.message,true);
  return;
 }

 window.location.href="/apply.html";
}

initialise();
</script>

</body>
</html>
